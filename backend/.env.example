# Copy to .env and adjust as needed
DATABASE_URL=sqlite:///./reimbursements.db
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Amazon SP-API (consent URL must use App ID, not LWA Client ID)
# AMAZON_APP_ID=amzn1.sp.solution.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
# AMAZON_LWA_CLIENT_SECRET=...
# AMAZON_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/amazon/callback
# AMAZON_AWS_IAM_ROLE_ARN=arn:aws:iam::...
# AMAZON_AWS_REGION=us-east-1