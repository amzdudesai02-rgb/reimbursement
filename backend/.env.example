# Copy to .env and adjust as needed
DATABASE_URL=sqlite:///./reimbursements.db
API_PREFIX=/api
# JSON array of allowed frontend origins (for signup/login CORS)
CORS_ORIGINS=["http://localhost:5173","https://reimbursement-psi.vercel.app","https://reimbursement.amzdudes.io"]

# Verification email (set one for signup/resend to work in production)
# Option A: Resend.com (recommended)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=no-reply@yourdomain.com
# Option B: SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# Link base URL for verification emails (defaults to FRONTEND_ORIGIN or localhost)
# FRONTEND_BASE_URL=https://reimbursement.amzdudes.io

# Amazon SP-API (consent URL must use App ID, not LWA Client ID)
# AMAZON_APP_ID=amzn1.sp.solution.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
# AMAZON_LWA_CLIENT_SECRET=...
# AMAZON_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/amazon/callback
# AMAZON_AWS_IAM_ROLE_ARN=arn:aws:iam::...
# AMAZON_AWS_REGION=us-east-1